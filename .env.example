# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Phone numbers must keep the "whatsapp:" prefix and use E.164 format
TWILIO_FROM_NUMBER=whatsapp:+14155550100
TWILIO_TO_NUMBER=whatsapp:+15555550123
